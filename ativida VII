Questão 1:

#include <stdio.h>

int main() {
    float vendas[7];
    float total = 0, media;
    float maior_valor;
    int dia_maior = 1;
    int valormaximo = 0;
    int i;

    for (i = 0; i < 7; i++) {
        printf("Digite o valor das vendas do dia %d: R$ ", i + 1);
        scanf("%f", &vendas[i]);
    }


    maior_valor = vendas[0];

    for (i = 0; i < 7; i++) {
        total += vendas[i];

        if (vendas[i] > maior_valor) {
            maior_valor = vendas[i];
            dia_maior = i + 1; 
        }


        if (vendas[i] > 1000.00) {
            valormaximo++;
        }
    }

    media = total / 7;

    printf("\n========================================\n");
    printf("            RELATORIO DE VENDAS         \n");
    printf("========================================\n");
    printf("Total vendido na semana: R$ %.2f\n", total);
    printf("Media diaria de vendas: R$ %.2f\n", media);
    printf("Dia com maior valor: Dia %d (R$ %.2f)\n", dia_maior, maior_valor);
    printf("Dias com vendas > R$ 1.000,00: %d dia(s)\n", valormaximo);
    printf("========================================\n");

    return 0;
}

Questão 2:

#include <stdio.h>

int main() {
    int numeros[6];
    int i;

    printf("Digite 6 numeros inteiros:\n");
    for (i = 0; i < 6; i++) {
        printf("Numero %d: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    printf("\nValores na ordem inversa:\n");
    for (i = 5; i >= 0; i--) {
        printf("%d ", numeros[i]);
    }
    printf("\n");

    return 0;
}
